# systemd unit for running wcl-discord-bot continuously on Ubuntu.
#
# Setup:
#   1. Copy the repo to the server, e.g. /opt/wcl-discord-bot, and run
#      `npm install` there.
#   2. Edit User=/WorkingDirectory= below to match where you deployed it and
#      which user should own the process (don't run it as root).
#   3. sudo cp deploy/wcl-discord-bot.service /etc/systemd/system/
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable --now wcl-discord-bot
#
# Useful commands:
#   sudo systemctl status wcl-discord-bot
#   sudo journalctl -u wcl-discord-bot -f
#   sudo systemctl restart wcl-discord-bot

[Unit]
Description=WCL Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wclbot
WorkingDirectory=/opt/wcl-discord-bot
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
EnvironmentFile=/opt/wcl-discord-bot/.env

# Hardening (optional but recommended)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/wcl-discord-bot/data

[Install]
WantedBy=multi-user.target
